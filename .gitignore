# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Build and packaging artifacts
build/
dist/
*.egg-info/
*.egg

# Virtual environments and local Python tooling
.venv/
venv/
env/
.python-version

# Test, coverage, lint, and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Streamlit local state
.streamlit/secrets.toml
.streamlit/config.toml

# Generated application outputs
outputs/*
!outputs/.gitkeep

# Local environment files
.env
.env.*

# Editor and OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
